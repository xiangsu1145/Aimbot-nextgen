# ── MediaTek NeuroPilot (closed-source backend) ─────────────────────
# NeuroPilot is built against MediaTek's proprietary SDK, which is not
# redistributable. The engine, its header, and the runtime symbols stay
# on developer machines and are wired in via AIMBOTNG_HAVE_NEUROPILOT.
app/src/main/cpp/include/NeuroPilotTFLite.h
app/src/main/cpp/inference/neuropilot_engine.h
app/src/main/cpp/inference/neuropilot_engine.cpp

# ── MediaTek Neuron APU delegate (private backend, not open-sourced) ──
# The project's own delegate + engine source. Kept out of the public repo;
# wired in via AIMBOTNG_HAVE_NEURON (see CMakeLists.txt / gradle.properties).
app/src/main/cpp/include/NeuronAdapter.h
app/src/main/cpp/inference/neuron_engine.h
app/src/main/cpp/inference/neuron_engine.cpp
app/src/main/cpp/inference/neuron_delegate.h
app/src/main/cpp/inference/neuron_delegate.cpp

